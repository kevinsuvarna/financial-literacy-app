# Copy to .env.local to sync progress to the API (apps/api). Without it the game makes no
# requests and progress stays on the device.
#
# Local development — `pnpm dev` starts the API here:
VITE_API_URL=http://localhost:8787
#
# For a production build, set it to the deployed Worker's URL instead, and put this site's
# origin in WEB_ORIGIN in apps/api/wrangler.jsonc.
